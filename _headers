# Netlify HTTP Headers — Response Electricians

# All pages — security headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache, no-store, must-revalidate

# CSS — short cache, versioned filenames handle cache busting
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# JS — short cache, versioned filenames handle cache busting
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Fonts — long cache (never change)
/fonts/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# Images — long cache
/images/*
  Cache-Control: public, max-age=2592000

# HTML pages — no cache so updates propagate immediately
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=86400

# Favicon
/images/favicon.png
  Cache-Control: public, max-age=31536000
